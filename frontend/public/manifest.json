{
  "manifest_version": 3,
  "name": "Schedule Builder",
  "version": "0.5.2",
  "description": "A cleaner class search and weekly schedule planner on top of your school's registration pages.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Schedule Builder",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://erp-registration.uncg.edu/StudentRegistrationSsb/*",
        "https://registration.uncw.edu/StudentRegistrationSsb/*",
        "https://banprd-reg.ecu.edu/StudentRegistrationSsb/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
